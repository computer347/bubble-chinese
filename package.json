{
  "name": "squish",
  "private": true,
  "version": "0.1.0",
  "description": "Pop soft, jiggly bubbles to learn Chinese.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/unit/content.test.ts",
    "e2e": "playwright test",
    "check": "npm run check:content && npm run typecheck && npm run test && npm run build && npm run e2e",
    "build:content": "node scripts/build-content.mjs",
    "check:content": "node scripts/build-content.mjs --check && node scripts/copy-strokes.mjs --check",
    "audio": "node scripts/generate-audio.mjs",
    "audio:sample": "node scripts/generate-audio.mjs --sample",
    "audio:status": "node scripts/generate-audio.mjs --status",
    "import:tatoeba": "node scripts/import-tatoeba.mjs",
    "strokes": "node scripts/copy-strokes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "hanzi-writer": "^3.7.3",
    "three": "^0.186.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "hanzi-writer-data": "^2.0.1",
    "typescript": "^7.0.2",
    "unbzip2-stream": "^1.4.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
