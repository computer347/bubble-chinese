{
  "name": "squish",
  "private": true,
  "version": "0.1.0",
  "description": "Pop soft, jiggly bubbles to learn Chinese.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/unit/content.test.ts",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
